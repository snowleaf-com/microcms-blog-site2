{
  "name": "hono-blog-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && wrangler dev",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./styles/globals.css -o ./public/styles.css --minify",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.8.12",
    "microcms-js-sdk": "^3.1.0",
    "shiki": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "wrangler": "^4.26.0"
  }
}
